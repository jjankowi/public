POLA_KWOT = ("PODST. ZDROW.", "ZDROW.", "ZAL. POD.", "KOSZTY", "ULGA POD.", "GOT", "ROR")
POLA_TEKSTU = {"PRACOWNIK": "w_komorce", "PESEL": "obok"}

def pole_tekstowe(ws, nazwa, gdzie):
    cel = bez_ogonkow(nazwa)
    for (c,) in ws.iter_rows(min_col=1, max_col=1):        # tylko kolumna A
        tekst = c.value.strip() if isinstance(c.value, str) else ""
        if not tekst or not bez_ogonkow(tekst).startswith(cel):
            continue                                        # to nie ta etykieta
        _, dwukropek, po = tekst.partition(":")             # 'Pracownik: Jan' -> 'Jan'
        if not dwukropek:                                   # bez dwukropka: odetnij pierwsze słowo
            po = tekst.split(None, 1)[1] if len(tekst.split(None, 1)) > 1 else ""
        if po.strip():
            return po.strip()                               # wartość była w komórce
        return tekst_obok(ws, c.row, c.column) if gdzie == "obok" else None
    return None                                             # etykiety nie ma w kolumnie A


for nazwa, gdzie in POLA_TEKSTU.items():
    wartosc = pole_tekstowe(ws, nazwa, gdzie)
    if nazwa == "PESEL" and wartosc and wartosc.isdigit():
        wartosc = wartosc.zfill(11)
    pola[etykieta(nazwa)] = wartosc


def scalenie(ws, wiersz, kol):
    """(od_wiersza, od_kol, do_wiersza, do_kol) scalenia, do którego należy komórka;
    dla zwykłej komórki to ona sama."""
    for z in ws.merged_cells.ranges:
        if z.min_row <= wiersz <= z.max_row and z.min_col <= kol <= z.max_col:
            return z.min_row, z.min_col, z.max_row, z.max_col
    return wiersz, kol, wiersz, kol


def zakres_komorki(ws, wiersz, kol):
    """(od_kol, do_kol) – dla komórki scalonej cały jej zakres, dla zwykłej (kol, kol)."""
    _, od_kol, _, do_kol = scalenie(ws, wiersz, kol)
    return od_kol, do_kol



# -------------------------------------------- część 3: pola „etykieta -> wartość”
def znajdz_etykiete(ws, nazwa):
    """(komórka, wartość_z_tej_samej_komórki) dla etykiety, np. 'ZAL. POD.' albo
    'Pracownik: Jan Kowalski' (wtedy wartość to tekst po dwukropku). Brak -> (None, None)."""
    cel = bez_ogonkow(nazwa)
    for wiersz in ws.iter_rows():
        for c in wiersz:
            if not isinstance(c.value, str):
                continue
            przed, _, po = c.value.partition(":")
            if po.strip() and bez_ogonkow(przed) == cel:
                return c, po.strip()
            if bez_ogonkow(c.value) == cel:  # dokładnie: 'ZDROW.' nie złapie 'PODST. ZDROW.'
                return c, None
    return None, None
 
 
def jest_etykieta(v):
    """Tekst, który nie jest liczbą (np. 'KOSZTY') – początek pola sąsiada."""
    return v is not None and str(v).strip() != "" and na_liczbe(v) is None 
def kwota_obok(ws, r, k):
    """Pierwsza liczba na prawo od etykiety w tym samym wierszu, ale przed następną
    etykietą – dalej są już kwoty innego pola (ZDROW. w J17 -> kwota w M17).
    Gdy etykieta jest scalona w pionie (np. J17:J18), sprawdza każdy jej wiersz."""
    od_w, _, do_w, _ = scalenie(ws, r, k)
    for rr in range(od_w, do_w + 1):
        for kk in range(k + 1, ws.max_column + 1):
            v = ws.cell(rr, kk).value
            kwota = na_liczbe(v)
            if kwota is not None:
                return kwota
            if jest_etykieta(v):
                break
    return None
def tekst_obok(ws, r, k):
    """Pierwsza niepusta komórka na prawo od etykiety, jako tekst. Tekst zakończony
    dwukropkiem to już następna etykieta (np. 'Tytuł ubezpieczenia:') – wtedy None."""
    for kk in range(k + 1, ws.max_column + 1):
        v = ws.cell(r, kk).value
        if v is not None and str(v).strip():
            if isinstance(v, float) and v.is_integer():
                v = int(v)
            tekst = str(v).strip()
            return None if tekst.endswith(":") else tekst
    return None
def pole_tekstowe(ws, nazwa, gdzie):
    """Szuka etykiety tylko w kolumnie A. Wartość to tekst po etykiecie w tej samej
    komórce ('Pracownik: Jan Kowalski' -> 'Jan Kowalski'); dla pól "obok", gdy w komórce
    jest sama etykieta, bierze pierwszą komórkę na prawo."""
    cel = bez_ogonkow(nazwa)
    for (c,) in ws.iter_rows(min_col=1, max_col=1):
        tekst = c.value.strip() if isinstance(c.value, str) else ""
        if not tekst or not bez_ogonkow(tekst).startswith(cel):
            continue
        _, dwukropek, po = tekst.partition(":")
        if not dwukropek:  # bez dwukropka: 'PRACOWNIK Jan Kowalski' – odcinamy pierwsze słowo
            po = tekst.split(None, 1)[1] if len(tekst.split(None, 1)) > 1 else ""
        if po.strip():
            return po.strip()
        return tekst_obok(ws, c.row, c.column) if gdzie == "obok" else None
    return None
def wczytaj_pola(ws):
    """{'PRACOWNIK': 'Jan Kowalski', 'PESEL': '...', 'PODST. ZDROW': Decimal, ...};
    pole, którego nie znaleziono, ma wartość None."""
    pola = {}
    for nazwa, gdzie in POLA_TEKSTU.items():
        wartosc = pole_tekstowe(ws, nazwa, gdzie)
        if nazwa == "PESEL" and wartosc and wartosc.isdigit():
            wartosc = wartosc.zfill(11)  # PESEL zapisany jako liczba gubi zero z przodu
        pola[etykieta(nazwa)] = wartosc
    for nazwa in POLA_KWOT:
        komorka, w_komorce = znajdz_etykiete(ws, nazwa)
        if komorka is None:
            wartosc = None
        else:
            wartosc = na_liczbe(w_komorce) if w_komorce else kwota_obok(ws, komorka.row, komorka.column)
        pola[etykieta(nazwa)] = wartosc
    return pola
